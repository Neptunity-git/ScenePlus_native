{
  "name": "NicoNico Danmaku AI",
  "mediatype": "code",
  "playmode": "loop",
  "path": "/index.js",
  "author": "ScenePlus AI Lab",
  "description": "Capture screen in low-res and let AI stream Danmaku comments like NicoNico Douga every 15 seconds. (API key can be set in index.js)",
  "version": "1.1.0",
  "params": [
    {
      "key": "commentStyle",
      "label": "Audience Mood",
      "type": "select",
      "options": [
        "Standard (標準)",
        "Tsukkomi (ツッコミ多め)",
        "Kansai (関西弁)",
        "Praise (全肯定・絶賛)",
        "Chaos (カオス・煽り)"
      ],
      "default": "Standard (標準)"
    },
    {
      "key": "commentDensity",
      "label": "Comments Per Batch",
      "type": "slider",
      "min": 8,
      "max": 25,
      "step": 1,
      "default": 15
    },
    {
      "key": "speedScale",
      "label": "Flow Speed",
      "type": "slider",
      "min": 0.5,
      "max": 2.5,
      "step": 0.1,
      "default": 1.0
    },
    {
      "key": "fontScale",
      "label": "Font Size",
      "type": "slider",
      "min": 0.6,
      "max": 2.0,
      "step": 0.1,
      "default": 1.0
    },
    {
      "key": "enableColors",
      "label": "Color Comments",
      "type": "toggle",
      "default": true
    }
  ]
}