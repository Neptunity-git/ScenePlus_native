{
  "name": "Absolute Cyber Sync",
  "mediatype": "code",
  "playmode": "hold",
  "path": "/index.js",
  "params": [
    { "key": "mainColor", "label": "Main Cyber Color", "type": "color", "default": "#00ffcc" },
    { "key": "accentColor", "label": "Accent Color", "type": "color", "default": "#ff00ff" },
    { "key": "audioSens", "label": "Audio Sensitivity", "type": "slider", "min": 0.1, "max": 3.0, "default": 1.2 },
    { "key": "glitchEnable", "label": "Desktop Glitch Mode", "type": "toggle", "default": true },
    { "key": "particleSpeed", "label": "Particle Velocity", "type": "slider", "min": 0.1, "max": 5.0, "default": 1.5 }
  ]
}
